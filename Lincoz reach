-- UI Update Logic
local function updateUI()
    if REACH_ACTIVE then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        ToggleBtn.Text = "STATUS: ACTIVE"
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60) -- Red
        ToggleBtn.Text = "STATUS: DISABLED"
    end
end

-- Toggle Handler
ToggleBtn.MouseButton1Click:Connect(function()
    REACH_ACTIVE = not REACH_ACTIVE
    updateUI()
end)

-- Typing Handler (Fires when you press Enter / finish typing)
InputBox.FocusLost:Connect(function(enterPressed)
    local numericInput = tonumber(InputBox.Text)
    
    if numericInput then
        -- Enforce rules: cannot be below 0, cannot be above 15
        if numericInput > MAX_REACH then
            REACH = MAX_REACH
        elseif numericInput < 0 then
            REACH = 0
        else
            REACH = numericInput
        end
    else
        -- Fallback to current valid value if gibberish text was entered
        REACH = REACH
    end
    
    -- Format and lock text input layout nicely
    InputBox.Text = string.format("%.1f", REACH)
    print("[Lincoz Reach Log] Reach distance updated manually to:", REACH)
end)

-- HOOK PIPELINE HOOKS BELOW
local F = {
    hook = hookfunction or hookfunc,
    gc = getgc,
    isL = islclosure or is_l_closure,
    meta = getrawmetatable,
    ro = setreadonly or function(t, b)
        if b then (make_readonly or function() end)(t)
        else (make_writeable or function() end)(t) end
    end,
    nc = newcclosure or function(f) return f end,
    check = checkcaller or function() return false end,
    info = debug and debug.getinfo,
}

local function getTorso(char)
    char = char or player.Character
    if not char then return nil end
    return char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

local function refreshTorso()
    if not (torso and torso.Parent) then
        torso = getTorso()
    end
    return torso
end

player.CharacterAdded:Connect(function(char)
    task.wait(0.2)
    torso = getTorso(char)
    hookedTouch, hookedClosest = nil, nil
end)

if player.Character then
    torso = getTorso(player.Character)
end

task.spawn(function()
    local field = workspace:WaitForChild("FootballField", 9e9)
    ball = field:FindFirstChild("SoccerBall")

    field.ChildAdded:Connect(function(c)
        if c.Name == "SoccerBall" then ball = c end
    end)

    field.ChildRemoved:Connect(function(c)
        if c == ball then ball = nil end
    end)
end)

local function ballAlive()
    return ball and ball.Parent
end

local function fname(f)
    local ok, info = pcall(F.info, f)
    return ok and info and info.name or nil
end

local function install()
    if not (F.gc and F.hook and F.isL and F.info) then return end

    local needT = not hookedTouch
    local needC = not hookedClosest
    if not (needT or needC) then return end

    for _, v in pairs(F.gc(true)) do
        if not (needT or needC) then break end
        if type(v) == "function" and F.isL(v) then
            if needT and fname(v) == "touchDetect" then
                local old = F.hook(v, F.nc(function(...)
                    refreshTorso()
                    touching = true
                    local ok, ret = pcall(oldTouch, ...)
                    touching = false
                    if ok then return ret end
                end))
                oldTouch = old
                hookedTouch = v
                needT = false
            elseif needC and fname(v) == "getClosestPlayerName" then
                local old = F.hook(v, F.nc(function(...)
                    if REACH_ACTIVE and PRIORITY and ballAlive() then
                        return LOCAL_NAME
                    end
                    return oldClosest(...)
                end))
                oldClosest = old
                hookedClosest = v
                needC = false
            end
        end
    end
end

task.spawn(function()
    while task.wait(1.2) do
        if not (hookedTouch and hookedClosest) then
            pcall(install)
        end
    end
end)

if F.meta and F.ro then
    local mt = F.meta(game)
    local oldIndex = mt.__index
    F.ro(mt, false)

    mt.__index = F.nc(function(obj, key)
        if not F.check()
            and REACH_ACTIVE
            and touching
            and key == "Position"
            and typeof(obj) == "Instance"
            and obj == torso
            and ball then

            local real = oldIndex(obj, key)
            local parent = oldIndex(ball, "Parent")
            if not parent then return real end

            local bpos = oldIndex(ball, "Position")
            local diff = real - bpos
            local dist = diff.Magnitude

            -- Dynamically uses the value you type directly inside the InputBox
            if dist <= SPOOF or dist > REACH or dist < 0.01 then
                return real
            end

            return bpos + (diff / dist) * SPOOF
        end
        return oldIndex(obj, key)
    end)

    F.ro(mt, true)
end

updateUI()
